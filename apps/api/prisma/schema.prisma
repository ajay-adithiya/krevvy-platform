generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       String @id @default(cuid())
  email    String @unique
  password String

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  sessions  AdminSession[]
}

model AdminSession {
  id               String    @id @default(cuid())
  adminId          String
  admin            Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id       String            @id @default(cuid())
  email    String            @unique
  name     String?
  phone    String?
  sessions CustomerSession[]
  orders   Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OtpCode {
  id         String   @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  isConsumed Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerSession {
  id               String    @id @default(cuid())
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OtpRateLimit {
  id           String   @id @default(cuid())
  email        String
  windowStart  DateTime
  requestCount Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, windowStart])
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  isActive Boolean @default(true)

  displayLabel String?
  iconName     String?
  displayOrder Int     @default(0)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id String @id @default(cuid())

  name String
  slug String @unique

  shortDescription String?
  description      String

  price         Decimal @db.Decimal(10, 2)
  stock         Int     @default(0)
  reservedStock Int     @default(0)

  amazonUrl String?

  isFeatured Boolean @default(true) // wait, original was false
  isActive   Boolean @default(true)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  images     ProductImage[]
  orderItems OrderItem[]

  // website-v1 additive fields
  tagline            String?
  isNewArrival       Boolean @default(false)
  isBestSeller       Boolean @default(false)
  discountLabel      String?
  ratingDisplay      Decimal @default(5.0) @db.Decimal(3, 1)
  reviewCountDisplay Int     @default(0)
  primaryColorAccent String?
  amazonButtonLabel  String?

  features         ProductFeature[]
  specifications   ProductSpecification[]
  featuredInGlobal GlobalSiteContent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductImage {
  id String @id @default(cuid())

  imageUrl String
  publicId String

  altText String?

  displayOrder Int @default(0)

  isPrimary Boolean @default(false)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id String @id @default(cuid())

  key   String @unique
  value Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  EXPIRED
  CANCELLED
  PROCESSING
  SHIPPED
  DELIVERED
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  customerName  String
  customerEmail String
  customerPhone String

  shippingAddressLine1 String
  shippingAddressLine2 String?
  shippingCity         String
  shippingState        String
  shippingPostalCode   String
  shippingCountry      String  @default("India")

  subTotal    Decimal @db.Decimal(10, 2)
  tax         Decimal @db.Decimal(10, 2)
  shippingFee Decimal @db.Decimal(10, 2)
  totalAmount Decimal @db.Decimal(10, 2)

  status OrderStatus @default(PENDING_PAYMENT)
  isPaid Boolean     @default(false)

  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  paidAt       DateTime?
  paymentError String?
  expiresAt    DateTime?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  productName String
  priceAtTime Decimal @db.Decimal(10, 2)

  quantity Int

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// WEBSITE-V1 CMS MODELS
// ------------------------------------------------------

model MediaAsset {
  id        String   @id @default(cuid())
  url       String
  publicId  String
  altText   String?
  filename  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  homeHeroes    HomePageContent[]
  globalSites   GlobalSiteContent[] @relation("LogoAsset")
  globalSitesOg GlobalSiteContent[] @relation("OgAsset")
}

model ProductFeature {
  id           String @id @default(cuid())
  productId    String
  title        String
  description  String
  displayOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductSpecification {
  id           String @id @default(cuid())
  productId    String
  name         String
  value        String
  displayOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model NavigationItem {
  id           String  @id @default(cuid())
  label        String
  targetView   String
  displayOrder Int     @default(0)
  isVisible    Boolean @default(true)
}

model FooterGroup {
  id           String       @id @default(cuid())
  title        String
  displayOrder Int          @default(0)
  isVisible    Boolean      @default(true)
  links        FooterLink[]
}

model FooterLink {
  id           String  @id @default(cuid())
  groupId      String
  label        String
  targetView   String
  displayOrder Int     @default(0)
  isVisible    Boolean @default(true)

  group FooterGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model FaqCategory {
  id           String    @id @default(cuid())
  slug         String    @unique
  displayLabel String
  displayOrder Int       @default(0)
  isVisible    Boolean   @default(true)
  faqs         FaqItem[]
}

model FaqItem {
  id            String  @id @default(cuid())
  faqCategoryId String
  question      String
  answer        String  @db.Text
  displayOrder  Int     @default(0)
  isVisible     Boolean @default(true)

  category FaqCategory @relation(fields: [faqCategoryId], references: [id], onDelete: Cascade)
}

model AboutPillar {
  id           String @id @default(cuid())
  title        String
  description  String @db.Text
  iconName     String
  displayOrder Int    @default(0)
}

model GlobalSiteContent {
  id Int @id @default(1)

  seoGlobalTitle       String?
  seoGlobalDescription String?     @db.Text
  seoOgMediaId         String?
  seoOgMedia           MediaAsset? @relation("OgAsset", fields: [seoOgMediaId], references: [id])
  logoMediaId          String?
  logoMedia            MediaAsset? @relation("LogoAsset", fields: [logoMediaId], references: [id])

  footerBrandDescription String? @db.Text
  copyrightText          String?
  complianceText         String? @db.Text

  mobileMenuOpenLabel  String?
  mobileMenuCloseLabel String?

  contactPhone  String?
  contactEmail  String?
  hqAddress     String?
  companyName   String?
  businessHours String?

  defaultAmazonProductId   String?
  defaultAmazonProduct     Product? @relation(fields: [defaultAmazonProductId], references: [id])
  buyOnAmazonLabel         String?
  amazonModalTitle         String?
  amazonModalSubtitle      String?
  amazonModalContinueLabel String?
  amazonModalCancelLabel   String?
  amazonModalTrustText     String?
  amazonModalVerifiedLabel String?
  amazonModalItemLabel     String?
  amazonModalPriceLabel    String?
}

model HomePageContent {
  id                Int         @id @default(1)
  heroEyebrow       String?
  heroTitle         String?
  heroSubtitle      String?     @db.Text
  heroCtaLabel      String?
  heroMediaId       String?
  heroMedia         MediaAsset? @relation(fields: [heroMediaId], references: [id])
  searchPlaceholder String?
  searchButtonLabel String?

  collectionEyebrow     String?
  collectionTitle       String?
  collectionDescription String? @db.Text
}

model ProductsPageContent {
  id                 Int     @id @default(1)
  pageEyebrow        String?
  pageTitle          String?
  pageSubtitle       String? @db.Text
  emptySearchMessage String?
  allProductsLabel   String?
  viewTechSpecsLabel String?
  hideTechSpecsLabel String?
  categoriesFilterLabel  String?
  newArrivalsFilterLabel String?
  bestSellersFilterLabel String?
  onDiscountFilterLabel  String?
  inStockLabel           String?
  warrantyLabel          String?
  featuresHeadingLabel   String?
  clearFilterLabel       String?
  viewDetailsButtonLabel String?
}

model AboutPageContent {
  id                        Int     @id @default(1)
  credoEyebrow              String?
  credoTitle                String?
  narrativeText             String? @db.Text
  enterpriseTitle           String?
  enterpriseDescription     String? @db.Text
  manufacturingBaseTitle    String?
  manufacturingBaseSubtitle String?
  certificationTitle        String?
  certificationDescription  String? @db.Text
  certificationBadgeLabel   String?
}

model ContactPageContent {
  id                        Int     @id @default(1)
  headerEyebrow             String?
  headerTitle               String?
  headerSubtitle            String? @db.Text
  warrantyCardTitle         String?
  warrantyCardText          String? @db.Text
  formNameLabel             String?
  formEmailLabel            String?
  formPhoneLabel            String?
  formCategoryLabel         String?
  formMessageLabel          String?
  formSubmitLabel           String?
  validationRequiredMessage String?
  validationEmailMessage    String?
  successMessageTitle       String?
  successMessageDescription String? @db.Text
  successResetButtonLabel   String?
  contactTouchpointsHeading String?
  contactPhoneHeading       String?
  contactEmailHeading       String?
  contactAddressHeading     String?
  formLoadingMessage        String?
  successTicketPrefixLabel  String?
}

model FaqPageContent {
  id                  Int     @id @default(1)
  headerEyebrow       String?
  headerTitle         String?
  headerSubtitle      String? @db.Text
  fallbackSupportText String? @db.Text
  allFaqsLabel        String?
}

model ContactInquiryOption {
  id           String  @id @default(cuid())
  value        String  @unique
  label        String
  displayOrder Int     @default(0)
  isVisible    Boolean @default(true)
}

model AmazonModalBenefit {
  id           String  @id @default(cuid())
  title        String
  description  String
  iconName     String?
  displayOrder Int     @default(0)
  isVisible    Boolean @default(true)
}
